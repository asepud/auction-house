{
  "info": {
    "_postman_id": "a1d3cfe8-9c55-4cac-b99e-0a90a6c46001",
    "name": "Rumah-Lelang Microservices",
    "description": "Collection untuk auction-service, payment-service, dan notification-service. Jalankan folder Auth terlebih dahulu, lalu Catalog dan Bidding.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "auctionBaseUrl", "value": "http://localhost:8083" },
    { "key": "paymentBaseUrl", "value": "http://localhost:8081" },
    { "key": "notificationBaseUrl", "value": "http://localhost:8082" },
    { "key": "sellerToken", "value": "" },
    { "key": "bidderToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "sellerId", "value": "" },
    { "key": "bidderId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "invoiceId", "value": "" },
    { "key": "categoryId", "value": "1" },
    { "key": "internalApiKey", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const now = Date.now();",
          "pm.collectionVariables.set('startTime', new Date(now - 60 * 1000).toISOString());",
          "pm.collectionVariables.set('endTime', new Date(now + 30 * 60 * 1000).toISOString());",
          "pm.collectionVariables.set('uniqueEmailSuffix', now.toString());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Seller\",\n  \"email\": \"seller.{{uniqueEmailSuffix}}@example.test\",\n  \"password\": \"Password123!\",\n  \"role\": \"SELLER\"\n}" },
            "url": "{{auctionBaseUrl}}/api/auth/register"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.collectionVariables.set('sellerToken', body.token);", "pm.collectionVariables.set('sellerId', String(body.userId));"] } }]
        },
        {
          "name": "Register Bidder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Bidder\",\n  \"email\": \"bidder.{{uniqueEmailSuffix}}@example.test\",\n  \"password\": \"Password123!\",\n  \"role\": \"BIDDER\"\n}" },
            "url": "{{auctionBaseUrl}}/api/auth/register"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "const body = pm.response.json();", "pm.collectionVariables.set('bidderToken', body.token);", "pm.collectionVariables.set('bidderId', String(body.userId));"] } }]
        },
        {
          "name": "Login Seed Admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@rumahlelang.local\",\n  \"password\": \"Admin123!\"\n}" },
            "url": "{{auctionBaseUrl}}/api/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OK', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('adminToken', pm.response.json().token);"] } }]
        }
      ]
    },
    {
      "name": "2. Auction Catalog",
      "item": [
        {
          "name": "List Seed Categories",
          "request": { "method": "GET", "url": "{{auctionBaseUrl}}/api/categories" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('OK', () => pm.response.to.have.status(200));", "const categories = pm.response.json();", "if (categories.length) pm.collectionVariables.set('categoryId', String(categories[0].id));"] } }]
        },
        {
          "name": "Create Auction Item (Seller)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Kamera Mirrorless - Postman Demo\",\n  \"description\": \"Item demonstrasi untuk alur bidding.\",\n  \"categoryId\": {{categoryId}},\n  \"startingPrice\": 1000000.00,\n  \"startTime\": \"{{startTime}}\",\n  \"endTime\": \"{{endTime}}\",\n  \"imageUrl\": \"https://example.test/images/camera.jpg\"\n}" },
            "url": "{{auctionBaseUrl}}/api/items"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('itemId', String(pm.response.json().id));"] } }]
        },
        { "name": "List Ongoing Auctions", "request": { "method": "GET", "url": "{{auctionBaseUrl}}/api/items?status=ONGOING" } },
        { "name": "Get Item Detail", "request": { "method": "GET", "url": "{{auctionBaseUrl}}/api/items/{{itemId}}" } }
      ]
    },
    {
      "name": "3. Bidding and Closing",
      "item": [
        {
          "name": "Place Valid Bid (Bidder)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{bidderToken}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"amount\": 1050000.00\n}" },
            "url": "{{auctionBaseUrl}}/api/items/{{itemId}}/bids"
          }
        },
        { "name": "Get Bid History", "request": { "method": "GET", "url": "{{auctionBaseUrl}}/api/items/{{itemId}}/bids" } },
        {
          "name": "Close Auction (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{auctionBaseUrl}}/api/items/{{itemId}}/close"
          }
        }
      ]
    },
    {
      "name": "4. Payment and Notification",
      "item": [
        {
          "name": "Get Invoice (set invoiceId manually)",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bidderToken}}" }], "url": "{{paymentBaseUrl}}/api/invoices/{{invoiceId}}" }
        },
        {
          "name": "Pay Invoice (set invoiceId manually)",
          "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{bidderToken}}" }], "url": "{{paymentBaseUrl}}/api/invoices/{{invoiceId}}/pay" }
        },
        {
          "name": "Bidder Notification History",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{bidderToken}}" }], "url": "{{notificationBaseUrl}}/api/notify/history/{{bidderId}}" }
        }
      ]
    },
    {
      "name": "5. Reports (Admin)",
      "item": [
        { "name": "Leaderboard", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{auctionBaseUrl}}/api/reports/leaderboard" } },
        { "name": "Top Sold Items", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{auctionBaseUrl}}/api/reports/items/top" } },
        { "name": "Seller Summary", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }], "url": "{{auctionBaseUrl}}/api/reports/sellers/{{sellerId}}/summary" } }
      ]
    }
  ]
}
